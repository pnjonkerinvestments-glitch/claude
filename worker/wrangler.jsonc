{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roviko",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Cloudflare-cron is UTC. 08:00-14:55 UTC dekt 04:00-09:30 ET in zowel zomer- als
  // wintertijd; de Worker bepaalt zelf of het echt premarket is en stopt anders meteen.
  // Let op: in Cloudflare-cron is 1 = zondag, dus gebruik de namen.
  "triggers": { "crons": ["*/5 8-14 * * MON-FRI"] },

  // Onthoudt welke tickers vandaag al gemaild zijn. Zonder id maakt
  // `wrangler deploy` de namespace bij de eerste deploy zelf aan.
  "kv_namespaces": [{ "binding": "STATE" }],

  // Filters. Secrets (SMTP_*, MAIL_TO, POLYGON_API_KEY, RUN_TOKEN) horen hier niet,
  // die zet je met `npx wrangler secret put <NAAM>`.
  "vars": {
    "PROVIDER": "tradingview",
    "THRESHOLD_PCT": "50",
    "MIN_PRICE": "1",
    "MAX_PRICE": "0",
    "MIN_PREMARKET_VOLUME": "50000",
    "MIN_DOLLAR_VOLUME": "100000",
    "EXCHANGES": "NASDAQ,NYSE,AMEX",
    "INSTRUMENT_TYPES": "stock,dr",
    "MAX_RESULTS": "50",
    "RE_ALERT_STEP_PCT": "25",
    "SUBJECT_PREFIX": "[Premarket]"
  }
}
