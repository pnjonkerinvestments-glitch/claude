# Sites provisions the DB binding using .openai/hosting.json.
# Never place secrets in NEXT_PUBLIC_* variables.
APPLICATION_URL=https://your-site.example
ENVIRONMENT=production
ADMIN_USER_IDS=
# Optional Google OAuth. Register <APPLICATION_URL>/api/auth/google as callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Strictly development only. Production never enables bots.
DEV_MULTIPLAYER_BOTS=false
# Reserved, disabled until explicitly configured and requested.
ANALYTICS_PROVIDER=none
QUICK_MATCH_ENABLED=false
RANKED_ENABLED=false
# For a future PostgreSQL / durable-room deployment adapter (unused by Sites V1).
DATABASE_URL=
