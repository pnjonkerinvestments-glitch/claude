# Kopieer naar .env voor lokaal draaien (of zet als GitHub Secrets/Variables).

# --- databron -------------------------------------------------------------
# tradingview = gratis, gebruikt het screener-endpoint van TradingView
# polygon     = betaalde, officieel gedocumenteerde API
PROVIDER=tradingview
POLYGON_API_KEY=

# --- filters --------------------------------------------------------------
THRESHOLD_PCT=50           # stijging in procenten t.o.v. de vorige slotkoers
MIN_PRICE=1                # negeer sub-dollar aandelen
MAX_PRICE=0                # 0 = geen bovengrens
MIN_PREMARKET_VOLUME=50000 # minimaal aantal verhandelde aandelen
MIN_DOLLAR_VOLUME=100000   # minimale omzet in dollars
EXCHANGES=NASDAQ,NYSE,AMEX # laat leeg om ook OTC mee te nemen
INSTRUMENT_TYPES=stock,dr  # dr = depositary receipt (ADR's)
MAX_RESULTS=50

# --- herhaling ------------------------------------------------------------
RE_ALERT_STEP_PCT=25       # pas opnieuw mailen als hij nog 25 procentpunt verder stijgt
STATE_PATH=.state/alerts.json

# --- e-mail ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587              # 587 = STARTTLS, 465 = SSL
SMTP_USER=jouwadres@gmail.com
SMTP_PASSWORD=             # Gmail: een app-wachtwoord, niet je gewone wachtwoord
MAIL_FROM=
MAIL_TO=jouwadres@gmail.com
SUBJECT_PREFIX=[Premarket]
